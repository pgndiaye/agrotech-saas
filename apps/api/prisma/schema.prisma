// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant (Coopérative / Organisation) ───────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cycle de vie plateforme : la suspension bloque l'accès de tous les membres
  // dès la requête suivante (contrôle dans JwtStrategy.validate).
  status           TenantStatus @default(ACTIVE)
  suspendedAt      DateTime?
  suspendedReason  String?
  suspendedBy      String?

  // Fiche administrative, renseignée depuis la console
  contactEmail String?
  contactPhone String?
  region       String?
  notes        String?
  trialEndsAt  DateTime?

  users          User[]
  stocks         Stock[]
  transactions   Transaction[]
  listings       Listing[]
  subscription   Subscription?
  payments       Payment[]
  smsAlertConfig SmsAlertConfig?
  smsLogs            SmsLog[]
  auditLogs          AuditLog[]
  subscriptionEvents SubscriptionEvent[]

  @@index([status])
  @@index([plan])
  @@index([createdAt])
}

enum Plan {
  FREE
  PREMIUM
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ─── User ──────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(FARMER)
  language     Language @default(FR)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  status          UserStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  lastLoginAt     DateTime?
  phone           String?
  // Tout token émis avant cette date est refusé. Positionné lors d'un
  // changement de rôle ou d'une suspension : révocation immédiate sans Redis.
  tokensRevokedAt DateTime?

  @@index([tenantId])
  @@index([status])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  FARMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Language {
  FR
  WO
}

// ─── Stock (Semences / Engrais / Récoltes) ─────────────────────────────────
model Stock {
  id          String      @id @default(cuid())
  name        String
  category    StockCategory
  quantity    Float
  unit        String
  minQuantity Float       @default(0)
  description String?
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  movements StockMovement[]

  @@index([tenantId, category])
}

enum StockCategory {
  SEEDS
  FERTILIZER
  HARVEST
  EQUIPMENT
  OTHER
}

model StockMovement {
  id        String        @id @default(cuid())
  stockId   String
  stock     Stock         @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Float
  note      String?
  createdAt DateTime      @default(now())

  @@index([stockId, createdAt])
}

enum MovementType {
  IN
  OUT
}

// ─── Finance (Revenus / Dépenses) ─────────────────────────────────────────
model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Float
  currency    String          @default("XOF")
  category    String
  description String?
  date        DateTime        @default(now())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, type])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ─── Marketplace ───────────────────────────────────────────────────────────
model Listing {
  id          String        @id @default(cuid())
  title       String
  description String?
  price       Float
  currency    String        @default("XOF")
  unit        String
  quantity    Float
  category    StockCategory
  status      ListingStatus @default(ACTIVE)
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([tenantId])
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

// ─── Subscription (Abonnement tenant) ─────────────────────────────────────
model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan               @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate   DateTime         @default(now())
  endDate     DateTime?
  autoRenew   Boolean          @default(false)
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payments Payment[]

  @@index([status, endDate])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

// ─── Payment (Historique paiements) ───────────────────────────────────────
model Payment {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  provider       PaymentProvider
  amount         Float
  currency       String          @default("XOF")
  status         PaymentStatus   @default(PENDING)
  // Unique : garantit l'idempotence si un webhook est rejoué par le provider
  externalId     String?         @unique // ID côté Wave ou Orange Money
  checkoutUrl    String?         // URL de paiement Wave
  phoneNumber    String?         // Numéro pour Orange Money
  planCode       Plan?           // Plan facturé, résolu côté serveur
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, createdAt])
  @@index([status])
}

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ─── SMS Alertes (Phase 5) ─────────────────────────────────────────────────
model SmsAlertConfig {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(true)
  phoneNumber    String
  city           String   @default("Dakar")
  stockAlerts    Boolean  @default(true)
  weatherAlerts  Boolean  @default(true)
  financeAlerts  Boolean  @default(true)
  weeklyDigest   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SmsLog {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber String
  message     String
  type        SmsAlertType
  status      SmsStatus
  provider    String?
  externalId  String?
  error       String?
  createdAt   DateTime     @default(now())

  @@index([tenantId, createdAt])
}

enum SmsAlertType {
  STOCK_CRITICAL
  STOCK_LOW
  WEATHER_ALERT
  FINANCE_ALERT
  WEEKLY_DIGEST
  TEST
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  SIMULATED
}

// ─── Journal d'audit des actions d'administration ──────────────────────────
// Écrit par l'AuditInterceptor (actions SUPER_ADMIN) et par AuditService.log()
// pour les actions système (expiration d'abonnement, webhooks).
// Seules les mutations sont journalisées : un handler sans @Audit() n'écrit rien.
model AuditLog {
  id             String      @id @default(cuid())
  actorId        String?
  actorEmail     String?
  actorRole      String      // SUPER_ADMIN | SYSTEM
  action         String      // TENANT_SUSPENDU, USER_ROLE_MODIFIE, …
  entity         String      // tenant | user | payment | planConfig
  entityId       String?
  targetTenantId String?
  targetTenant   Tenant?     @relation(fields: [targetTenantId], references: [id], onDelete: SetNull)
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  status         AuditStatus @default(SUCCESS)
  errorMessage   String?
  createdAt      DateTime    @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([targetTenantId])
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

// ─── Exécutions de tâches planifiées ───────────────────────────────────────
// Deux rôles : déduplication PERSISTANTE (contrairement à l'état en mémoire
// qui était perdu au redémarrage) et journal d'exécution consultable.
// La contrainte d'unicité (taskName, runKey) est ce qui garantit qu'une même
// occurrence n'est jouée qu'une fois, y compris avec plusieurs instances.
model TaskRun {
  id        String        @id @default(cuid())
  taskName  String
  runKey    String        // "2026-08-19" (quotidien) ou "2026-W34" (hebdo)
  status    TaskRunStatus @default(RUNNING)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  result    Json?
  error     String?

  @@unique([taskName, runKey])
  @@index([taskName, startedAt])
}

enum TaskRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ─── Catalogue tarifaire ───────────────────────────────────────────────────
// Cohabite avec l'enum `Plan` : celui-ci reste le discriminant typé de
// Tenant.plan et Subscription.plan, PlanConfig porte le prix, les quotas et
// les fonctionnalités. Une ligne par membre de l'enum (garanti par le seed).
model PlanConfig {
  id            String        @id @default(cuid())
  code          Plan          @unique
  label         String
  description   String?
  // Entier : jamais de flottant pour de la monnaie.
  priceXof      Int           @default(0)
  billingPeriod BillingPeriod @default(MONTHLY)
  isActive      Boolean       @default(true)
  isPublic      Boolean       @default(true)
  sortOrder     Int           @default(0)
  // { users, stocks, listings, smsPerMonth } — la valeur -1 signifie illimité
  quotas        Json          @default("{}")
  // { exportCsv, smsAlerts, marketplacePublish, aiRecommendations }
  features      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, sortOrder])
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

// ─── Historique des abonnements ────────────────────────────────────────────
// `Subscription` ne conserve que l'état courant : sans cet historique, le
// churn et le taux de conversion sont incalculables.
model SubscriptionEvent {
  id             String                @id @default(cuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  type           SubscriptionEventType
  fromPlan       Plan?
  toPlan         Plan?
  amountXof      Int?
  source         String                // WEBHOOK | ADMIN | SYSTEM | SIMULATION
  occurredAt     DateTime              @default(now())
  metadata       Json?

  @@index([occurredAt])
  @@index([tenantId, occurredAt])
  @@index([type, occurredAt])
}

enum SubscriptionEventType {
  CREATED
  RENEWED
  UPGRADED
  DOWNGRADED
  EXPIRED
  CANCELLED
  REACTIVATED
}
